# Copy to .env and fill in from Supabase → Project Settings → API.
# The anon key is safe in the browser only because Row Level Security is on for every table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave empty to use built-in example data (no Supabase needed).
# VITE_DATA_SOURCE=mock
# Push notifications: the public VAPID key (safe to publish). `npm run gen:vapid` makes a key pair.
VITE_VAPID_PUBLIC_KEY=
